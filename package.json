{
  "name": "yosegi-workspace",
  "version": "0.0.0",
  "private": true,
  "author": "Salim Salimzade",
  "description": "A SolidJS design system, made for my own projects",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter playground --filter web dev",
    "dev:playground": "pnpm --filter playground dev",
    "dev:web": "pnpm --filter web dev",
    "generate": "pnpm --filter yosegi generate",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "changeset": "changeset",
    "release": "pnpm --filter yosegi build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "typescript": "catalog:"
  }
}
