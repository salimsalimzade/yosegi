// The landing page as a Cloudflare Worker that only serves static assets, at
// yosegi.<account>.workers.dev. Deployed by .github/workflows/ci.yml.
{
  "name": "yosegi",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // The router runs in the browser, so every unknown path gets index.html.
    "not_found_handling": "single-page-application"
  }
}
