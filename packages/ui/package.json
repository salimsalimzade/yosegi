{
  "name": "yosegi-solid",
  "version": "0.4.0",
  "author": "Salim Salimzade",
  "description": "A SolidJS design system, made for my own projects",
  "keywords": [
    "solid",
    "solidjs",
    "design-system",
    "ui",
    "a11y"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://yosegi.learningishardiswear.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salimsalimzade/yosegi.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./global.css": "./src/styles/global.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/source/index.d.ts",
        "solid": "./dist/source/index.js",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/source/styles/index.css",
      "./tokens.css": "./dist/source/styles/tokens.css",
      "./global.css": "./dist/source/styles/global.css",
      "./fonts.css": "./dist/source/styles/fonts.css"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-icons.js",
    "build": "node scripts/generate-icons.js --check && vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.17",
    "solid-js": "^2.0.0-rc.17"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "sass-embedded": "catalog:",
    "solid-js": "catalog:",
    "svgo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:"
  }
}
