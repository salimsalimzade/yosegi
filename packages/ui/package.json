{
  "name": "yosegi",
  "version": "0.0.0",
  "description": "A SolidJS design system, made for my own projects",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salimsalimzade/yosegi.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/source/index.d.ts",
        "solid": "./dist/source/index.js",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.17",
    "solid-js": "^2.0.0-rc.17"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
